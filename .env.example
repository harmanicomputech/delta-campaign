# =============================================================================
# Campaign Operations Platform — environment reference
# Copy to .env and fill in. Never commit real secrets.
# Variables for later phases are listed (commented) so the full picture is visible.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Campaign Operations"
APP_ENV=local                      # local | staging | production
APP_KEY=                           # php artisan key:generate
APP_DEBUG=true                     # MUST be false in staging/production
APP_URL=http://localhost:8000
CAMPAIGN_DISPLAY_TIMEZONE=Africa/Lagos   # storage is always UTC; this is for display

APP_LOCALE=en                      # en | pcm (Nigerian Pidgin)
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG
SUPPORTED_LOCALES=en,pcm

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# Show the internal design-system reference at /design-system (never in production).
DESIGN_SYSTEM_ENABLED=true

BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
# local: "stack" with LOG_STACK=daily | staging/production: LOG_CHANNEL=json (stdout, JSON lines)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# --- Security headers --------------------------------------------------------
SECURITY_HSTS_ENABLED=false        # true in production (behind TLS)
SECURITY_CSP_REPORT_URI=           # optional CSP report endpoint

# Comma-separated proxy IPs/CIDRs trusted for X-Forwarded-* (load balancer). "*" only behind a private LB.
TRUSTED_PROXIES=

# --- Database: PostgreSQL 16 + PostGIS 3.4 -----------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=campaign
DB_USERNAME=campaign
DB_PASSWORD=
DB_SSLMODE=prefer                  # require in staging/production

# --- Redis: cache, queues, rate limits, USSD state ---------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=campaign_

CACHE_STORE=redis
CACHE_PREFIX=campaign_cache_
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=120
REDIS_LONG_QUEUE_RETRY_AFTER=1900  # must exceed the bulk supervisor's 1800 s timeout

# Database sessions allow users to list and revoke their own sessions (Phase 3).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false        # true in staging/production
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log           # reverb from Phase 6

# --- Horizon -----------------------------------------------------------------
HORIZON_PATH=ops/horizon
HORIZON_PREFIX=campaign_horizon:

# --- Storage (S3-compatible; private by default) -----------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=                      # e.g. MinIO / R2 / Spaces endpoint
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail (operational notifications only) -----------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Data protection keys ----------------------------------------------------
# Generate both with: php artisan campaign:keys   (production refuses to boot without them)
PHONE_HASH_KEY=                    # HMAC key for phone-number hashes. Never rotate without a re-hash plan.
FIELD_ENCRYPTION_KEY=              # Key for encrypted personal-data columns (separate from APP_KEY).

# --- Authentication -----------------------------------------------------------
AUTH_OTP_TTL=300                   # seconds a one-time code stays valid
AUTH_OTP_PER_PHONE_PER_HOUR=5
AUTH_OTP_PER_IP_PER_HOUR=30
AUTH_PIN_CONFIRM_MINUTES=15        # sensitive actions re-ask for the PIN after this
AUTH_IDLE_LOCK_MINUTES=30          # idle sessions lock and need the PIN (or a code) to resume

# --- SMS ------------------------------------------------------------------------
SMS_DRIVER=outbox                  # outbox (local developer outbox, never sends) | africastalking

# --- Africa's Talking ---------------------------------------------------------
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SMS_SENDER_ID=
AFRICASTALKING_USSD_SERVICE_CODE=
AFRICASTALKING_WEBHOOK_SECRET=     # shared secret required on callback URLs (?key=…)

# --- WhatsApp Business Platform (Phase 9) ------------------------------------
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=             # verifies webhook signatures
# WHATSAPP_VERIFY_TOKEN=

# --- Real-time: Laravel Reverb (Phase 6) -------------------------------------
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
